# ─── ضروری ───
# توکن ربات از BotFather (مثل 123456:ABC-DEF...)
BOT_TOKEN=put-your-bot-token-here
# آیدی عددی ادمین‌ها با کاما جدا کن (مثل 123456789,987654321)
ADMIN_IDS=123456789

# ─── اختیاری (مقادیر پیش‌فرض همین‌ها هستن) ───
DB_PATH=data/bot.db
TEMP_DIR=temp
PREXZY_API_BASE=https://prexzyapis.com
FREE_DAILY_LIMIT=3
PRO_DAILY_LIMIT=50
AI_FREE_DAILY=15
AI_PRO_DAILY=100
FREE_MAX_MB=20
PRO_MAX_MB=20
MAX_INPUT_SECONDS=300
FFMPEG_TIMEOUT=240
INVITES_FOR_PRO=2
PRO_DAYS=15
TIMEZONE=Asia/Tehran
